# Copiá este archivo como .env y completá los valores.

# Clave de la API de OpenWeatherMap (obligatoria). https://openweathermap.org/api
API_KEY=

# Clave secreta de Flask para sesiones/firmas.
SECRET_KEY=

# Modo debug (no usar True en producción).
FLASK_DEBUG=False

# Host y puerto del servidor de desarrollo.
HOST=127.0.0.1
PORT=5000
